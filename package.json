{
  "name": "qrcode-hassle-free",
  "version": "1.0.1",
  "description": "Remote hassle-free access for DeepSeek Harness: a cloudflared quick tunnel plus a scannable QR code and settings shown in the Settings → Plugins page. No database, no Firebase.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raiyan007-gb/dsh-qrcode-hassle-free.git"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "qrcode",
    "cloudflared",
    "remote"
  ],
  "license": "MIT",
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
